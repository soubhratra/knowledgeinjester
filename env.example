# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/knowledgeinjester

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.0

# Supabase Configuration (for vector storage)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Django Configuration
SECRET_KEY=your_secret_key_here
DEBUG=True
ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# API Configuration
RETRIEVAL_TOP_K=6

# Logging
LOG_LEVEL=INFO

# Superuser Configuration (for production deployment)
# These variables are used by the startup.py script to create a superuser automatically
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your_secure_password_here

# LangSmith Configuration
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=spectrum-chat
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
